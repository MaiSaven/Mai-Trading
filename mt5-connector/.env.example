# Backend API Sync Endpoint
BACKEND_SYNC_URL=http://localhost:8000/api/v1/sync

# API Security Key
API_KEY=mai-trading-secret-key

# Sync Settings
SYNC_INTERVAL_SECONDS=10
HISTORY_DAYS=60
AUTO_SIMULATION_FALLBACK=false

# MT5 Account Credentials (leave empty if logging in directly via MT5 desktop)
ACCOUNT_LOGIN=
ACCOUNT_PASSWORD=
SERVER=
TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
