# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, or * to allow all)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:9669@localhost:5432/mai-trading
DB_SCHEMA=trading
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mai-trading
DB_USER=postgres
DB_PASSWORD=9669

# API Security
API_KEY=mai-trading-secret-key

# Demo / Seed Data
# Set to "true" to allow the /sync/seed-demo endpoint to insert demo trades.
# Set to "false" (default) to completely disable demo data seeding.
ENABLE_DEMO_DATA=false
